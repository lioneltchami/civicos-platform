# =============================================================================
# CivicOS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values for local development.
# Generate DJANGO_SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NEVER commit .env to version control.
#
# Production values can be injected by your deployment platform or loaded from
# a local .env.prod file for Docker Compose deployments.
# =============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development

# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# JWT RS256 key pair (required in production)
# Generate: openssl genrsa -out jwt_private.pem 4096
# Then:     openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste content with \n replacing actual newlines
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
SPECTACULAR_PUBLIC=False

# Nginx host port binding for Docker Compose deployments
CIVICOS_HOST_HTTP_BIND=0.0.0.0
CIVICOS_HOST_HTTP_PORT=80

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://civicos:civicos@localhost:5432/civicos
POSTGRES_DB=civicos
POSTGRES_USER=civicos
POSTGRES_PASSWORD=change-me-db-password

# Keep database connections open for this many seconds (reduces overhead)
CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Cache & Celery (Redis)
# ---------------------------------------------------------------------------

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# Fernet keys for encrypted application fields in production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=change-me-generate-a-real-fernet-key
VOLUNTEER_SIN_FERNET_KEYS=change-me-generate-a-real-fernet-key

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

DEFAULT_FROM_EMAIL=noreply@civicos.local
SERVER_EMAIL=errors@civicos.local

# Production: set EMAIL_BACKEND to anymail backend and provide API key
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=

# ---------------------------------------------------------------------------
# Wagtail
# ---------------------------------------------------------------------------

WAGTAIL_SITE_NAME=CivicOS (Local)
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Optional: used by `make superuser` / `python manage.py bootstrap_superuser`
# DJANGO_SUPERUSER_EMAIL=admin@civicos.local
# DJANGO_SUPERUSER_PASSWORD=change-me

# ---------------------------------------------------------------------------
# File storage (production — leave blank in development)
# ---------------------------------------------------------------------------

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ca-central-1
# AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# CivicOS application settings
# ---------------------------------------------------------------------------

# GC Notify API key for email/SMS in production
# GC_NOTIFY_API_KEY=

# Audit log retention in days (default: 2555 = 7 years)
AUDIT_LOG_RETENTION_DAYS=2555

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# ---------------------------------------------------------------------------
# Error tracking (production)
# ---------------------------------------------------------------------------

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Production security (not needed in development)
# ---------------------------------------------------------------------------

# REQUIRED in production — comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.ca,https://www.yourdomain.ca

# Admin email recipients for 500 error alerts
# DJANGO_ADMINS=Admin:admin@yourdomain.ca
