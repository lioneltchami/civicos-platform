# =============================================================================
# Govstack — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env to version control.
#
# Production values are injected by your deployment platform (Kubernetes
# secrets, AWS Secrets Manager, etc.) — do not use a .env file in production.
# =============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development

# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://govstack:govstack@localhost:5432/govstack

# Keep database connections open for this many seconds (reduces overhead)
CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Cache & Celery (Redis)
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

DEFAULT_FROM_EMAIL=noreply@govstack.local
SERVER_EMAIL=errors@govstack.local

# Production: set EMAIL_BACKEND to anymail backend and provide API key
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# Wagtail
# ---------------------------------------------------------------------------

WAGTAIL_SITE_NAME=Govstack (Local)
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Optional: used by `make superuser` / `python manage.py bootstrap_superuser`
# DJANGO_SUPERUSER_EMAIL=admin@govstack.local
# DJANGO_SUPERUSER_PASSWORD=change-me

# ---------------------------------------------------------------------------
# File storage (production — leave blank in development)
# ---------------------------------------------------------------------------

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ca-central-1
# AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# Govstack application settings
# ---------------------------------------------------------------------------

# GC Notify API key for email/SMS in production
# GC_NOTIFY_API_KEY=

# Audit log retention in days (default: 2555 = 7 years)
AUDIT_LOG_RETENTION_DAYS=2555

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# ---------------------------------------------------------------------------
# Error tracking (production)
# ---------------------------------------------------------------------------

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Production security (not needed in development)
# ---------------------------------------------------------------------------

# CSRF_TRUSTED_ORIGINS=https://yourdomain.ca,https://www.yourdomain.ca
